---
import { portfolio, type Lang } from '../data/portfolio';
interface Props { lang?: Lang; }
const lang = Astro.props.lang ?? 'es';
const { person, ui } = portfolio[lang];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const disciplines = lang === 'es' ? ['IDEAS', 'DISEÑO', 'TECNOLOGÍA', 'IMPACTO'] : ['IDEAS', 'DESIGN', 'TECHNOLOGY', 'IMPACT'];
---
<section id="inicio" class="hero hero-fullbleed" aria-labelledby="hero-name">
  <div class="hero-backdrop" aria-hidden="true">
    <i></i><i></i><i></i>
  </div>
  <div class="hero-art-stage" aria-hidden="true">
    <img class="hero-art-image hero-art-background" src={`${basePath}/IF.webp`} alt="" fetchpriority="high" />
  </div>
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="shell hero-inner">
    <div class="hero-copy">
      <img class="hero-mobile-logo" src={`${basePath}/LOGO2FC3.webp`} alt="" aria-hidden="true" />
      <p class="eyebrow">{lang === 'es' ? 'DESARROLLADOR FULL-STACK | APLICACIONES WEB | AUTOMATIZACIÓN | DATOS E IA' : 'FULL-STACK DEVELOPER | WEB APPLICATIONS | AUTOMATION | DATA & AI'}</p>
      <h1 id="hero-name"><span class="hero-first">{person.displayName.split(' ')[0]}</span><span class="hero-last">FELIPE<span class="accent">.</span></span><span class="hero-mobile-name">{person.displayName}</span><span class="hero-mobile-surname">Cuasquer Rosero</span></h1>
    </div>
    <div class="hero-actions">
      <a class="button" href="#proyectos">{ui.viewProjects}</a>
      <a class="button" href={person.cv} download>{ui.downloadCv}</a>
    </div>
    <a class="hero-scroll" href="#proyectos">{lang === 'es' ? 'Desliza para explorar' : 'Scroll to explore'} <span aria-hidden="true">↓</span></a>
  </div>
  <div class="discipline-carousel" role="region" aria-label={lang === 'es' ? 'Ideas, diseño, tecnología e impacto' : 'Ideas, design, technology and impact'}>
    <div class="discipline-track" aria-hidden="true">
      {Array.from({ length: 2 }).map(() =>
        <div class="discipline-set">
          {disciplines.map((discipline, index) =>
            <span class="discipline-item">
              <span class:list={['discipline-word', { 'is-outline': index % 2 === 1 }]}>{discipline}</span>
              <span class="discipline-separator"><i></i><i></i></span>
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</section>
<script>
  const heroSection = document.querySelector<HTMLElement>('.hero-fullbleed');
  const heroPortrait = document.querySelector<HTMLElement>('.hero-art-stage');
  const portraitMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  heroSection?.addEventListener('pointermove', event => {
    if (!heroPortrait || event.pointerType === 'touch' || portraitMotionQuery.matches) return;
    const bounds = heroSection.getBoundingClientRect();
    const x = (event.clientX - bounds.left) / bounds.width - .5;
    const y = (event.clientY - bounds.top) / bounds.height - .5;
    heroPortrait.style.setProperty('--hero-shift-x', `${(x * 24).toFixed(1)}px`);
    heroPortrait.style.setProperty('--hero-shift-y', `${(y * 16).toFixed(1)}px`);
  });
  const resetPortrait = () => {
    heroPortrait?.style.setProperty('--hero-shift-x', '0px');
    heroPortrait?.style.setProperty('--hero-shift-y', '0px');
  };
  heroSection?.addEventListener('pointerleave', resetPortrait);
  portraitMotionQuery.addEventListener('change', resetPortrait);
</script>
