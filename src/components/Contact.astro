---
import { portfolio, type Lang } from '../data/portfolio';
interface Props { lang?: Lang; }
const lang = Astro.props.lang ?? 'es';
const { person, ui } = portfolio[lang];
const gmailHref = 'https://mail.google.com/mail/?view=cm&fs=1&to=' + encodeURIComponent(person.email) + '&su=' + encodeURIComponent(ui.emailSubject);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id="contacto" class="contact-section">
  <div class="shell">
    <div class="contact-top">
      <p class="eyebrow">{lang === 'es' ? 'CONTACTO' : 'CONTACT'}</p>
      <span class="mono">{lang === 'es' ? 'WEB · AUTOMATIZACIÓN · DATOS E IA' : 'WEB · AUTOMATION · DATA & AI'}</span>
    </div>

    <div class="contact-layout">
      <h2>{lang === 'es' ? 'Hablemos' : 'Let’s talk'}<em>{lang === 'es' ? 'de tu idea.' : 'about your idea.'}</em></h2>
      <div class="contact-emblem" aria-hidden="true">
        <img src={basePath + '/LOGO2FC3.webp'} alt="" />
      </div>
    </div>

    <div class="contact-action">
      <p>{ui.sections.contactText}</p>
      <a class="button contact-cta" href={gmailHref} target="_blank" rel="noopener noreferrer">{lang === 'es' ? 'Escríbeme' : 'Email me'}</a>
    </div>
  </div>
</section>
