---
import { portfolio, type Lang } from '../data/portfolio';
interface Props { lang?: Lang; }
const lang = Astro.props.lang ?? 'es';
const { experience, formativeExperience, ui } = portfolio[lang];
---
<section id="experiencia" class="section experience-section">
  <div class="shell">
    <div class="experience-intro">
      <div>
        <p class="eyebrow">{lang === 'es' ? 'TRAYECTORIA' : 'EXPERIENCE'}</p>
        <h2 class="display-title">{lang === 'es' ? 'Siempre' : 'Always'}<em>{lang === 'es' ? 'en movimiento.' : 'moving forward.'}</em></h2>
      </div>
      <p class="experience-lead">{ui.sections.experienceTitle}</p>
    </div>

    <div class="timeline">
      {experience.map(item => <article class="timeline-row">
        <div class="timeline-date"><span class="mono">{item.date}</span></div>
        <div class="timeline-entry">
          <div class="timeline-entry-meta">
            <p class="eyebrow">{item.organization}</p>
            {item.project && <span class="project-tag">{item.project}</span>}
          </div>
          <h3>{item.role}</h3>
          <div class="timeline-description timeline-description-desktop">{item.description.split('\n\n').map(paragraph => <p>{paragraph}</p>)}</div>
          <details class="mobile-disclosure timeline-disclosure">
            <summary>{lang === 'es' ? 'Ver detalles' : 'View details'}<span aria-hidden="true">+</span></summary>
            <div class="timeline-description timeline-description-mobile">{item.description.split('\n\n').map(paragraph => <p>{paragraph}</p>)}</div>
          </details>
        </div>
      </article>)}
    </div>

    <div class="training-section">
      <h3>{ui.sections.formativeTitle}</h3>
      <div class="training-grid">
        {formativeExperience.map(item => <article>
          <span class="mono">{item.date}</span>
          <h4>{item.role}</h4>
          <p class="training-organization">{item.organization}</p>
          <div class="training-description-desktop">{item.description.split('\n\n').map(paragraph => <p>{paragraph}</p>)}</div>
          <details class="mobile-disclosure training-disclosure">
            <summary>{lang === 'es' ? 'Ver detalles' : 'View details'}<span aria-hidden="true">+</span></summary>
            <div>{item.description.split('\n\n').map(paragraph => <p>{paragraph}</p>)}</div>
          </details>
        </article>)}
      </div>
    </div>
  </div>
</section>
