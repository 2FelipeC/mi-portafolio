---
import { portfolio, type Lang } from '../data/portfolio';

interface Props { lang?: Lang; }

const lang = Astro.props.lang ?? 'es';
const { intellectualProperty, publications } = portfolio[lang];
const software = intellectualProperty[0];
---

<section id="publicaciones" class="section research-section">
  <div class="shell">
    <div class="research-intro">
      <p class="eyebrow">{lang === 'es' ? 'INVESTIGACIÓN & SOFTWARE' : 'RESEARCH & SOFTWARE'}</p>
      <h2 class="display-title">
        {lang === 'es' ? 'Del laboratorio' : 'From research'}<br />
        <em>{lang === 'es' ? 'a la herramienta.' : 'to real tools.'}</em>
      </h2>
    </div>

    <article class="research-feature">
      <div class="research-feature-meta">
        <span class="eyebrow">{software.type}</span>
        <span class="mono">{software.date}</span>
      </div>
      <div class="research-feature-content">
        <h3>{software.title}</h3>
        <p class="research-description">{software.description}</p>
        <p class="research-credit">{software.role}</p>
        <p class="research-register">{software.registrationLabel}: {software.venue}</p>
      </div>
    </article>

    <div class="research-publications">
      <h3>{lang === 'es' ? 'Publicaciones' : 'Publications'}</h3>
      <div class="research-publication-list">
        {publications.map(item => <article class="publication-row">
          <div class="publication-meta">
            <span class="eyebrow">{item.type}</span>
            <span class="mono">{item.date}</span>
          </div>
          <div class="publication-content">
            <h4>{item.title}</h4>
            <p>{item.venue}</p>
          </div>
        </article>)}
      </div>
    </div>
  </div>
</section>
