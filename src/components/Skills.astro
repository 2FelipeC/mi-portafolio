---
import { portfolio, type Lang } from '../data/portfolio';
interface Props { lang?: Lang; }
const lang = Astro.props.lang ?? 'es';
const { specialties, skills } = portfolio[lang];
---
<section id="especialidades" class="section shell specialties-section">
  <div class="specialties-layout">
    <div class="specialties-intro">
      <p class="eyebrow">{lang === 'es' ? 'LO QUE CONSTRUYO' : 'WHAT I BUILD'}</p>
      <h2 class="display-title">{lang === 'es' ? 'De la idea' : 'From idea'}<em>{lang === 'es' ? 'a la solución.' : 'to solution.'}</em></h2>
      <p class="specialties-lead">{lang === 'es' ? 'Desarrollo, automatización y datos. Una visión completa para cada parte del producto.' : 'Development, automation and data. A complete perspective on every part of the product.'}</p>
    </div>
    <div class="services">
      {specialties.map(item => <article class="service-row">
        <div class="service-heading"><h3>{item.title}</h3><span class="service-kicker" aria-hidden="true">{item.icon}</span></div>
        <p class="service-description-desktop">{item.description}</p>
        <details class="mobile-disclosure service-disclosure">
          <summary>{lang === 'es' ? 'Ver detalles' : 'View details'}<span aria-hidden="true">+</span></summary>
          <p>{item.description}</p>
        </details>
      </article>)}
    </div>
  </div>
  <div id="habilidades" class="stack-panel"><div><p class="eyebrow">{lang === 'es' ? 'MI CAJA DE HERRAMIENTAS' : 'MY TOOLBOX'}</p><h3>{lang === 'es' ? 'El stack detrás' : 'The stack behind'}<br /><em>{lang === 'es' ? 'de cada idea.' : 'every idea.'}</em></h3></div><div class="skill-groups">{skills.map(group => <details class="skill-group"><summary>{group.category}<span aria-hidden="true">+</span></summary><ul class="tags">{group.items.map(skill => <li>{skill}</li>)}</ul></details>)}</div></div>
</section>
