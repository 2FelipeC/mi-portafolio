---
import { portfolio, type Lang } from '../data/portfolio';
interface Props { lang?: Lang; }
const lang = Astro.props.lang ?? 'es';
const { education } = portfolio[lang];
---
<section id="formacion" class="section shell education-section">
  <div>
    <p class="eyebrow">{lang === 'es' ? 'FORMACIÓN' : 'EDUCATION'}</p>
    <h2 class="display-title">{lang === 'es' ? 'Aprender.' : 'Learn.'}<br /><em>{lang === 'es' ? 'Construir.' : 'Build.'}</em><br />{lang === 'es' ? 'Repetir.' : 'Repeat.'}</h2>
  </div>
  <div class="education-list">
    {education.map(item => <article>
      <div class="project-meta"><span>{item.date}</span></div>
      <h3>{item.degree}</h3>
      <p class="institution">{item.institution}</p>
      <p class="education-description-desktop">{item.description}</p>
      <details class="mobile-disclosure education-disclosure">
        <summary>{lang === 'es' ? 'Ver detalles' : 'View details'}<span aria-hidden="true">+</span></summary>
        <p>{item.description}</p>
      </details>
    </article>)}
  </div>
</section>
