---
import { portfolio, type Lang } from '../data/portfolio';
interface Props { lang?: Lang; }
const lang = Astro.props.lang ?? 'es';
const { person, ui } = portfolio[lang];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = lang === 'es'
  ? [['Proyectos', '#proyectos'], ['Sobre mí', '#perfil'], ['Especialidades', '#especialidades'], ['Trayectoria', '#experiencia'], ['Formación', '#formacion'], ['Investigación', '#publicaciones'], [ui.contact, '#contacto']]
  : [['Work', '#proyectos'], ['About', '#perfil'], ['Expertise', '#especialidades'], ['Experience', '#experiencia'], ['Education', '#formacion'], ['Research', '#publicaciones'], [ui.contact, '#contacto']];
---
<a class="skip-link" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="#inicio" aria-label={ui.homeAria}><img src={basePath + '/LOGO2FC3.webp'} alt="2FC" /></a>
    <span class="header-note">{person.displayName}<br /><span>Cuasquer Rosero</span></span>
    <a class="header-center-mark" href="#inicio" aria-label={ui.homeAria}><img src={basePath + '/LOGO2FC3.webp'} alt="" /></a>
    <div class="header-actions">
      <a class="language-link" href={ui.otherLocaleHref} aria-label={lang === 'es' ? 'Leer en inglés' : 'Read in Spanish'}>{ui.otherLocaleName}</a>
      <button id="menu-toggle" class="icon-button menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label={ui.menuAria} data-open-label={ui.menuAria} data-close-label={lang === 'es' ? 'Cerrar menú' : 'Close menu'}><span class="menu-icon" aria-hidden="true"><i></i><i></i></span></button>
    </div>
  </div>
</header>
<nav id="site-menu" class="header-menu" aria-label={ui.navLabel} hidden>
  <div class="menu-links">{links.map(([label, href]) => <a href={href}>{label}</a>)}</div>
  <a class="menu-signature" href="#inicio" aria-label={ui.homeAria}><img src={basePath + '/LOGO2FC3.webp'} alt="2FC" /></a>
  <div class="menu-social" aria-label={lang === 'es' ? 'Redes profesionales' : 'Professional profiles'}>
    <a href={person.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8"/></svg>
      <span>GitHub</span>
    </a>
    <a href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708C16 15.487 15.474 16 14.825 16H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.71-.521-1.248-1.342-1.248S2.4 3.225 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.633v3.866h2.401V9.25c0-2.22-1.184-3.252-2.763-3.252-1.274 0-1.845.7-2.166 1.193v.025h-.016a5 5 0 0 1 .016-.025V6.17H6.251c.03.678 0 7.225 0 7.225z"/></svg>
      <span>LinkedIn</span>
    </a>
  </div>
</nav>
<script>
  const button = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const menu = document.querySelector<HTMLElement>('#site-menu');
  const header = document.querySelector<HTMLElement>('.site-header');
  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 16);
  const setMenuOpen = (open: boolean) => {
    if (!menu || !button) return;
    menu.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? button.dataset.closeLabel ?? '' : button.dataset.openLabel ?? '');
    header?.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
  };
  const closeMenu = () => setMenuOpen(false);
  button?.addEventListener('click', () => setMenuOpen(menu?.hidden ?? false));
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu && !menu.hidden) { closeMenu(); button?.focus(); } });
  document.addEventListener('pointerdown', event => {
    const target = event.target as Node;
    if (menu && !menu.hidden && !header?.contains(target) && !menu.contains(target)) closeMenu();
  });
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>
