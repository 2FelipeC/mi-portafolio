---
import { portfolio, type Lang } from '../data/portfolio';
interface Props { lang?: Lang; }
const lang = Astro.props.lang ?? 'es';
const content = portfolio[lang];
---
<section id="perfil" class="section about-section">
  <div class="shell about-grid"><div><p class="eyebrow">{lang === 'es' ? 'DETRÁS DEL CÓDIGO' : 'BEHIND THE CODE'}</p><h2 class="display-title">{lang === 'es' ? 'Curiosidad' : 'Curiosity'}<em>{lang === 'es' ? 'sin límites.' : 'without limits.'}</em></h2><div class="about-mark" aria-hidden="true">✳</div><span class="mono">{lang === 'es' ? 'DESARROLLADOR FULL STACK' : 'FULL-STACK DEVELOPER'}</span></div><div class="about-copy"><p class="large-copy">{content.person.impact}</p>{content.profile.split('\n\n').map(paragraph => <p>{paragraph}</p>)}<a class="button" href={content.person.cv} download>{content.ui.downloadCv}</a></div></div>
</section>
