---
import { portfolio, type Lang } from '../data/portfolio';
interface Props { lang?: Lang; }
const lang = Astro.props.lang ?? 'es';
const { projects } = portfolio[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id="proyectos" class="section work-section">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{lang === 'es' ? 'PROYECTOS SELECCIONADOS' : 'SELECTED WORK'}</p>
        <h2 class="display-title">{lang === 'es' ? 'Del código' : 'From code'}<br /><em>{lang === 'es' ? 'al mundo real.' : 'to the real world.'}</em></h2>
      </div>
      <p class="heading-aside">{lang === 'es' ? 'Una selección de aplicaciones, productos web y soluciones de datos con las que he trabajado.' : 'A selection of applications, web products and data solutions I have worked on.'}</p>
    </div>
  </div>

  <div class="project-scroll-scene" data-project-scene>
    <div class="project-scroll-sticky">
      <div class="project-runway" role="region" aria-label={lang === 'es' ? 'Recorrido de proyectos' : 'Project journey'} data-project-runway>
        <svg class="project-thread" viewBox="0 0 4000 800" preserveAspectRatio="none" aria-hidden="true"><path d="M-40 610 C260 680 450 115 800 185 S1330 730 1690 510 S2250 60 2610 195 S3140 690 3540 425 S3890 165 4070 260" /></svg>
        {projects.map((project, i) => <>
          <article class={`project-story project-story-${i + 1}`} aria-label={project.title}>
            <div class="project-info">
              <div class="project-logo-frame"><img class="project-logo" src={base + '/' + project.image.dark.replace('.png', '.webp')} alt={project.image.alt} loading="lazy" /></div>
              <div class="project-heading">
                <p class="project-meta">{project.type}</p>
                <h3 aria-label={project.title}>{project.title.split(' — ').at(-1)}</h3>
              </div>
              <div class="project-copy project-copy-desktop">
                <p>{project.description}</p>
                <ul class="tags" aria-label={lang === 'es' ? 'Tecnologías' : 'Technologies'}>{project.technologies.map(tech => <li>{tech}</li>)}</ul>
                <div class="project-story-bottom">
                  <details class="project-details"><summary>{lang === 'es' ? 'Mi contribución' : 'My contribution'}<span aria-hidden="true">+</span></summary><p>{project.role}</p></details>
                  {project.links.filter(link => !link.temporary).map(link => <a class="button" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
                </div>
              </div>
              <details class="project-mobile-details">
                <summary>{lang === 'es' ? 'Ver detalles' : 'View details'}<span aria-hidden="true">+</span></summary>
                <div class="project-mobile-detail-content">
                  <p>{project.description}</p>
                  <ul class="tags" aria-label={lang === 'es' ? 'Tecnologías' : 'Technologies'}>{project.technologies.map(tech => <li>{tech}</li>)}</ul>
                  <div class="project-story-bottom">
                    <details class="project-details"><summary>{lang === 'es' ? 'Mi contribución' : 'My contribution'}<span aria-hidden="true">+</span></summary><p>{project.role}</p></details>
                    {project.links.filter(link => !link.temporary).map(link => <a class="button" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
                  </div>
                </div>
              </details>
            </div>
          </article>
        </>)}
      </div>
    </div>
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('[data-project-scene]');
  const runway = scene?.querySelector<HTMLElement>('[data-project-runway]');
  if (scene && runway) {
    const desktop = window.matchMedia('(min-width: 901px) and (min-height: 621px) and (prefers-reduced-motion: no-preference)');
    let distance = 0;
    let frame = 0;

    const render = () => {
      if (!desktop.matches) return;
      const traveled = Math.min(distance, Math.max(0, -scene.getBoundingClientRect().top));
      runway.style.transform = `translate3d(${-traveled}px, 0, 0)`;
    };
    const requestRender = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(render); };
    const measure = () => {
      if (desktop.matches) {
        runway.style.transform = '';
        distance = Math.max(0, runway.scrollWidth - window.innerWidth);
        scene.style.height = `${distance + window.innerHeight}px`;
      } else {
        distance = 0;
        scene.style.height = '';
        runway.style.transform = '';
      }
      requestRender();
    };

    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', measure);
    desktop.addEventListener('change', measure);
    measure();
  }
</script>
